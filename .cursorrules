{
    "rules": {
      "documentation_reference": {
        "description": "Protocol for referencing documentation",
        "steps": [
          "Before starting any task, review the relevant documentation in the project",
          "Refer to the documentation files located in the 'docs' folder",
          "Use the information from these documents to inform code generation and decision-making"
        ]
      },
      "context_initialization": {
        "description": "Starting point for each interaction",
        "steps": [
          "State the current goal and overall project context",
          "Briefly recap progress made so far",
          "Explain the reasoning behind the next planned action",
          "Reference relevant project documentation"
        ]
      },
      "operational_protocol": {
        "description": "How to approach tasks",
        "before_action": [
          "Review relevant project documentation",
          "Explain how the next step aligns with the overall goal",
          "Describe potential impacts or consequences of the action"
        ],
        "after_action": [
          "Summarize what was done and why",
          "Evaluate the outcome against the goal and documentation guidelines",
          "Identify any necessary adjustments or next steps"
        ]
      },
      "code_generation": {
        "description": "Protocol for generating and testing code",
        "steps": [
          "Review relevant documentation in the project",
          "Write unit tests for the planned code",
          "Generate the required code based on documentation guidelines",
          "Run the tests automatically",
          "If errors are found, explain and fix them",
          "Rerun tests until all pass",
          "Explain the final code and its functionality"
        ]
      },
      "error_handling": {
        "description": "How to deal with errors or issues",
        "steps": [
          "Identify and explain the error or issue",
          "Consult project documentation for relevant error handling guidelines",
          "Propose multiple solutions if applicable",
          "Implement the most suitable solution",
          "Verify the solution resolves the issue",
          "Update relevant documentation or comments"
        ]
      },
      "progress_tracking": {
        "description": "Regular progress updates",
        "frequency": "After every major task or every 30 minutes, whichever comes first",
        "steps": [
          "Summarize overall progress towards the main goal",
          "List completed tasks and their outcomes",
          "Identify upcoming tasks and their priorities",
          "Highlight any potential roadblocks or concerns",
          "Verify alignment with project documentation"
        ]
      },
      "documentation_maintenance": {
        "description": "Maintaining clear documentation",
        "steps": [
          "Update comments in code as changes are made",
          "Maintain a running changelog of significant changes",
          "Ensure README.md is up-to-date with latest project status",
          "Suggest updates to project documentation if discrepancies are found"
        ]
      }
    },
    "global_instructions": [
      "Always reference the project documentation before writing code or making decisions",
      "The documentation is located in the 'docs' folder of the project",
      "Ensure all code adheres to the guidelines and best practices outlined in the documentation",
      "If documentation is unclear or missing, request clarification before proceeding",
      "Consider the broader context of the project when making decisions",
      "Prioritize maintainability and readability in all code generation",
      "Regularly verify alignment with the original project goals",
      "If unsure about a decision, ask for clarification before proceeding",
      "Proactively suggest improvements or optimizations when identified",
      "Explain your reasoning and actions in each response",
      "Maintain focus on the main project objectives throughout all tasks"
    ]
  }
  